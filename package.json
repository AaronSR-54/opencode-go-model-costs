{
  "name": "@aaronsr-54/opencode-go-model-costs",
  "version": "1.7.1",
  "description": "OpenCode TUI plugin that shows Go provider models ranked by plan-quota burn rate (cost relative to each model's usage limit)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronSR-54/opencode-go-model-costs.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./server.js"
    },
    "./tui": {
      "default": "./tui.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "bin": {
    "opencode-go-model-costs": "./bin/init.js"
  },
  "dependencies": {
    "@opentui/solid": ">=0.5.8",
    "jsonc-parser": "^3.3.1",
    "solid-js": "^1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "@opentui/core": ">=0.5.8"
  },
  "files": [
    "server.js",
    "tui.tsx",
    "tui.js",
    "tui-core.js",
    "tui-v2-types.ts",
    "bin",
    "package.json"
  ],
  "scripts": {
    "build": "node build-tui.mjs",
    "test": "node --test",
    "prepublishOnly": "node build-tui.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "babel-preset-solid": "^1.9.12"
  }
}
